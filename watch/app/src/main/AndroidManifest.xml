<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
      蓝牙（BLE 外设模式）：广播 + GATT Server 只需要这两个级别为 normal 的权限，
      targetSdk 30 下装即得，**不需要运行时申请、也不需要 ACCESS_FINE_LOCATION**
      （定位权限是"手表做 Central 去扫描"才要的，本方案反过来做 Peripheral，已实测不需要）。
      不加 maxSdkVersion：将来若升 targetSdk，它们会自动退化为无需申请的历史权限，
      而 API 31+ 的 BLUETOOTH_ADVERTISE/CONNECT 到那时才需要补。
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <uses-feature android:name="android.hardware.type.watch" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.WristDeck">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:screenOrientation="portrait" />

        <service
            android:name=".svc.BridgeService"
            android:enabled="true"
            android:exported="false" />

        <!-- 阶段 3 前置探针：exported 只是为了能用 adb am start 直接驱动，正式功能里不需要。 -->
        <activity
            android:name=".ui.ProbeActivity"
            android:exported="true"
            android:label="@string/title_probe"
            android:screenOrientation="portrait" />

        <service
            android:name=".svc.ProbeService"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
