    <string name="status_off">已断开</string>
    <string name="status_connecting">连接中</string>
    <string name="status_ready">已连接</string>
    <string name="status_denied">PIN 错误</string>
    <string name="status_exec_offline">浏览器未就绪</string>
    <string name="status_unconfirmed">未确认（可能已执行）</string>
    <string name="status_busy">点太快了，稍等</string>

    <!-- 无障碍标签：方向键与播放键显示的是几何图形，TalkBack 需要文字描述 -->
    <string name="key_up">上</string>
    <string name="key_down">下</string>
    <string name="key_left">左</string>
    <string name="key_right">右</string>
    <string name="key_play_pause">播放或暂停</string>

    <string name="hint_host">PC 局域网 IP</string>
    <string name="hint_port">端口</string>
    <string name="hint_pin">配对 PIN</string>
    <string name="link_ble">用蓝牙连接</string>
    <string name="link_ble_hint">手表直接连 Mac，不用填 IP、不用同一网段。需要 Mac 上运行 WristDeckLink 应用。关掉则改用 Wi-Fi 直连。</string>
    <string name="keep_alive">后台保持连接</string>
    <string name="gesture_on">手腕手势</string>
    <!-- v0.5：闸门从"屏幕亮"改成"连接状态"，这句必须跟着改 —— 否则页面上还在说"灭屏后只留 5 秒"，
         而实际行为是"连上就一直认（含熄屏）、断开才停"，用户按老文案理解会以为手势在熄屏后失效。 -->
    <string name="gesture_hint">连接后一直有效（含熄屏），断开即停；翻表盘 = 播放/暂停</string>
    <string name="gesture_off_suffix"> · 手势关</string>
    <string name="save_and_connect">保存并连接</string>
    <string name="test">测试</string>
    <string name="saved">已保存，正在连接…</string>
    <!-- 断开状态下点"保存并连接"：只保存，不偷偷把链路拉回来 -->
    <string name="saved_off">已保存；当前是断开状态，回主页点「连接」</string>
    <!-- 断开状态下点"测试" -->
    <string name="need_link">当前已断开，请回主页点「连接」</string>
    <!-- 主页底部的连接总闸（和"设置"并排） -->
    <string name="link_connect">连接</string>
